# AWS — Bedrock access for Amazon Nova Sonic (voice) and Nova Micro (text sub-agents)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SESSION_TOKEN=your_aws_session_token_if_using_temporary_credentials
# Optional: use an AWS CLI/SSO profile instead of the keys above
# AWS_PROFILE=your_profile_name

# Zapier MCP — sends order-confirmation emails via Gmail
ZAPIER_MCP_URL=your_zapier_mcp_url
